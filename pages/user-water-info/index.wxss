/* pages/user-water-info/index.wxss */


.user-water-info {
  background-color: #fff;
  display: flex;
  flex-direction: column;
  height: 100%;
  overflow: hidden;
}

.info {
  flex: 1;
  min-height: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.info-label {
  flex-shrink: 0;
  padding: 20rpx 32rpx;
  border-bottom: 1px solid #ebeef5;
}

.info-content {
  flex: 1;
  height: 0;
}

.info-item {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  padding: 20rpx 32rpx;
}

.info-item__label {
  font-size: 24rpx;
  width: auto;
  overflow: hidden;
  color: rgba(69, 90, 100, 0.6);
}

.info-item__info {
  flex: 1;
  padding-left: 30rpx;
  display: flex;
  justify-content: flex-end;
}
.btn{
  flex-shrink: 0;
  display: flex;
  font-size: 28rpx;
}
.btn-item{
  flex: 1;
  text-align: center;
  border-top: 1px solid #ebeef5;
  padding: 20rpx;
}

.over {
  flex: 1;
}

.btn-row-hall {
  display: flex;
  width: 100%;
  flex-wrap: nowrap;
}

.btn-third {
  flex: 0 0 33.33%;
  width: 33.33%;
  box-sizing: border-box;
}

.btn-fill {
  flex: 1;
  width: auto;
  min-width: 0;
  box-sizing: border-box;
}

.btn-vertical {
  flex-direction: column;
  width: 100%;
  padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.btn-vertical .btn-item {
  width: 100%;
  flex: none;
  border-top: none;
  border-radius: 8rpx;
  padding: 8rpx 20rpx;
  margin-bottom: 20rpx;
}

.btn-vertical .btn-item:last-child {
  margin-bottom: 0;
}

.btn-item-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #fff;
  line-height: 1.2;
}

.ftfr-pay-popup {
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.ftfr-pay-title {
  padding: 28rpx 32rpx 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  border-bottom: 1px solid #ebeef5;
}

.ftfr-pay-actions {
  margin: 32rpx 24rpx 12rpx;
}