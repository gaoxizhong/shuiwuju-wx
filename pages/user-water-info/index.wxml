<!--pages/user-water-info/index.wxml-->
<view class="container user-water-info">
  <view class="info">
    <view class="info-label">
      {{lang.title}}
    </view>
    <scroll-view scroll-y class="info-content">
      <view class="info-item">
        <view class="info-item__label">{{lang.wm_no}}</view>
        <view class="info-item__info">{{form.wm_no}}</view>
      </view>
      <view class="info-item">
        <view class="info-item__label">{{lang.wm_name}}</view>
        <view class="info-item__info">{{form.meter.wm_name || form.wm_name}}</view>
      </view>
      <view class="info-item">
        <view class="info-item__label">{{lang.last_water}}</view>
        <view class="info-item__info">{{form.last_reading}}（m³）</view>
      </view>
      <view class="info-item">
        <view class="info-item__label">{{lang.reading}}</view>
        <view class="info-item__info">{{form.reading}}（m³）</view>
      </view>
      <view class="info-item">
        <view class="info-item__label">{{lang.total_water}}</view>
        <view class="info-item__info">{{form.water}}（m³）</view>
      </view>
      <view class="info-item">
        <view class="info-item__label">{{lang.createDate}}</view>
        <view class="info-item__info">{{form.createDate}}</view>
      </view>
      <view class="info-item">
        <view class="info-item__label">{{lang.total_money}}</view>
        <view class="info-item__info">{{form.price}}（KZ）</view>
      </view>
      <view class="info-item">
        <view class="info-item__label">{{lang.arrears_total}}</view>
        <view class="info-item__info">{{arrears_money_t}}（KZ）</view>
      </view>
      <view class="info-item">
        <view class="info-item__label">{{lang.waterList}}</view>
        <van-image width="200" height="140" fit="cover" src="{{form.image}}" />
      </view>
    </scroll-view>
  </view>
  <!--
    查表员 / 营业厅：始终展示 FT / FR / 其他金额
    - 未支付：三个都可点
    - 已支付 / FT·FR 完成后：前两个置灰，仅「其他金额」可点
    financial-manager：同意 / 不同意
  -->
  <view class="btn {{(source === 'search-person' || source === 'business-hall') ? 'btn-vertical' : ''}}">
    <block wx:if="{{source === 'search-person' || source === 'business-hall'}}">
      <view class="btn-item {{(ftfrSubmitting || ftFrDisabled) ? 'btn-return' : ''}}" data-type="FT" bindtap="{{(ftfrSubmitting || ftFrDisabled) ? '' : 'openFtFrPay'}}">
        <view>{{lang.ftBtn}}</view>
        <view class="btn-item-sub">{{lang.payThisBillSub}}</view>
      </view>
      <view class="btn-item {{(ftfrSubmitting || ftFrDisabled) ? 'btn-return' : ''}}" data-type="FR" bindtap="{{(ftfrSubmitting || ftFrDisabled) ? '' : 'openFtFrPay'}}">
        <view>{{lang.frBtn}}</view>
        <view class="btn-item-sub">{{lang.payThisBillSub}}</view>
      </view>
      <view class="btn-item {{ftfrSubmitting ? 'btn-return' : ''}}" bindtap="{{ftfrSubmitting ? '' : 'showPayPopup'}}">
        <view>{{lang.otherAmountBtn}}</view>
        <view class="btn-item-sub">{{lang.otherAmountSub}}</view>
      </view>
    </block>

    <!-- 财务审核入口 source=financial-manager -->
    <block wx:if="{{source === 'financial-manager'}}">
      <!-- status=no：待审核 -->
      <view wx:if="{{status === 'no'}}" class="btn-item" data-status="1" style="border-right: 1px solid #ebeef5;" bindtap="handleInfoStatus">
        {{btnName.agree}}
      </view>
      <view wx:if="{{status === 'no'}}" class="btn-item" data-status="2" bindtap="handleOpenResult">
        {{btnName.disagree}}
      </view>
    </block>
  </view>

  <!-- FT / FR 缴费弹窗 -->
  <van-popup show="{{ showFtFrPay }}" position="bottom" round bind:close="onCloseFtFrPay" custom-style="max-height: 80%;">
    <view class="ftfr-pay-popup">
      <view class="ftfr-pay-title">{{lang.payPopupTitle}}</view>
      <view class="info-item">
        <view class="info-item__label">{{lang.wm_no}}</view>
        <view class="info-item__info">{{form.wm_no}}</view>
      </view>
      <view class="info-item">
        <view class="info-item__label">{{lang.wm_name}}</view>
        <view class="info-item__info">{{form.meter.wm_name || form.wm_name}}</view>
      </view>
      <view class="info-item">
        <view class="info-item__label">{{lang.total_money}}</view>
        <view class="info-item__info">{{form.price}}（KZ）</view>
      </view>
      <van-cell-group>
        <van-field
          type="digit"
          custom-style="flex-direction: column;"
          title-width="100%"
          readonly
          required
          label="{{lang.paid_total_money}}  (KZ)"
          model:value="{{ paid_total_money }}"
          placeholder="{{lang.paid_total_money}}"
        />
      </van-cell-group>
      <van-cell-group>
        <van-field
          custom-style="flex-direction: column;"
          title-width="100%"
          readonly
          required
          error="{{pay_type_error}}"
          label="{{lang.pay_type}}"
          model:value="{{ pay_text }}"
          placeholder="{{lang.pay_type}}"
          bindtap="showPayWayPicker"
        />
      </van-cell-group>
      <van-cell-group wx:if="{{ showCheck }}">
        <van-field
          type="digit"
          custom-style="flex-direction: column;"
          title-width="100%"
          required
          error="{{ check_num_error }}"
          label="{{lang.cheque_number}}"
          model:value="{{ cheque_number }}"
          placeholder="{{lang.cheque_number}}"
        />
      </van-cell-group>
      <view class="ftfr-pay-actions">
        <van-button type="info" block bind:click="submitFtFrPay" loading="{{ ftfrSubmitting }}">
          {{ payDocType === 'FR' ? lang.submitPrintFr : lang.submitPrintFt }}
        </van-button>
      </view>
    </view>
  </van-popup>

  <!-- 支付方式选择（与 user-total-info 一致；z-index 高于缴费弹窗） -->
  <van-popup show="{{ showPay }}" position="bottom" z-index="110" custom-style="height: 300px;" bind:close="onClosePay">
    <van-picker id="pay" show-toolbar default-index="{{ totIndex }}" columns="{{ payStatusList }}" confirm-button-text="{{langDialog.confirmText}}" cancel-button-text="{{langDialog.cancelText}}" bind:confirm="onConfirmPay" bind:cancel="onClosePay" />
  </van-popup>
  <!-- 拒绝原因 -->
  <van-popup show="{{ showResult }}" position="bottom" bind:close="onCloseResult">
    <van-field custom-style="flex-direction: column;" required title-width="100%" label="{{lang.check_detail}}" value="{{ check_detail }}" type="textarea" autosize="{{size}}" placeholder="{{lang.placeholder}}" error="{{check_detail_error}}" bind:change="handleInputCheckDetail" />
    <view style="margin: 20rpx;text-align: right;">
      <van-button type="info" size="small" bind:click="handleInputResult" style="margin-right: 20rpx;">{{btnName.submitName}}</van-button>
      <van-button type="info" plain size="small" bind:click="onCloseResult">{{lang.cancelName}}</van-button>
    </view>
  </van-popup>
</view>
