/* pages/query-water/pay/print-info/index.wxss */
.print-info {
  display: flex;
  flex-direction: column;
}

.print-info__content {
  flex: 1;
  overflow: hidden;
  margin-top: 20rpx;
  background-color: #fff;
  display: flex;
  flex-direction: column;
}

.info {
  flex: 1;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.info-content {
  flex: 1;
  height: 0;
}

.info-label {
  padding: 20rpx 32rpx;
  border-bottom: 1px solid #ebeef5;
}

.info-item {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  padding: 20rpx 32rpx;
}

.info-item__label {
  font-size: 24rpx;
  width: auto;
  overflow: hidden;
  color: rgba(69, 90, 100, 0.6);
}

.info-item__info {
  flex: 1;
  padding-left: 30rpx;
  display: flex;
  justify-content: flex-end;
}

.info-item--photo {
  flex-direction: column;
  align-items: flex-start;
}

.info-item--photo .info-item__info {
  justify-content: flex-start;
  padding-left: 0;
  margin-top: 16rpx;
}

.history-section {
  padding: 0 32rpx 24rpx;
}

.history-section__title {
  font-size: 28rpx;
  color: rgba(69, 90, 100, 0.6);
  padding: 16rpx 0;
}

.loglist-box {
  width: 100%;
}

.loglist-title-box {
  display: flex;
  align-items: center;
  font-weight: bold;
  border-bottom: 1rpx solid #ebeef5;
  font-size: 22rpx;
}

.loglist-title-box--history > view,
.loglist-item-box--history > view {
  flex: 1;
  text-align: center;
  padding: 16rpx 4rpx;
  font-size: 22rpx;
  word-break: break-all;
}

.loglist-item-box {
  display: flex;
  align-items: center;
  border-bottom: 1rpx dotted #ebeef5;
}

.history-list-body {
  min-height: 80rpx;
}

.history-empty {
  padding: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}
.btn{
  display: flex;
  align-items: stretch;
  font-size: 28rpx;
}
.btn-item{
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  border-top: 1px solid #ebeef5;
  padding: 20rpx;
  margin: 0 10rpx;
  box-sizing: border-box;
  line-height: 1.3;
}

.over {
  flex: 1;
}