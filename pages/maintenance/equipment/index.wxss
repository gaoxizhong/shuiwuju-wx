.equipment-page {
  min-height: 100%;
  padding: 20rpx;
  box-sizing: border-box;
  background-color: #f2f2f2;
}

.equipment-panel {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 20rpx;
}

.equipment-grid {
  display: flex;
  flex-wrap: wrap;
}

.equipment-btn {
  width: 50%;
  padding: 24rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.equipment-btn__icon {
  width: 128rpx;
  height: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.equipment-btn__icon image {
  width: 128rpx;
  height: 128rpx;
}

.equipment-btn__text {
  margin-top: 8rpx;
  font-size: 28rpx;
  text-align: center;
  padding: 0 12rpx;
}
